{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@core/*": ["src/core/*"],
      "@providers/*": ["src/providers/*"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/core/**/*",
    "src/providers/**/*",
    "src/shared/**/*",
    "extension/captions.ts",
    "test/**/*"
  ],
  // Renderer and extension tests use their respective configs for DOM/Chrome
  // types, which are not available to the main process.
  "exclude": ["test/player.test.ts", "test/popup-copy.test.ts", "test/video-background.test.ts", "test/video-native-client.test.ts", "test/video-timing.test.ts", "test/video-panel.test.ts"]
}
