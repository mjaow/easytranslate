{
  "manifest_version": 3,
  "name": "EasyTranslate · Understand video",
  "version": "0.1.0",
  "description": "English analysis of YouTube transcripts, with evidence, follow-up questions, and optional Chinese translation.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "scripting",
    "nativeMessaging",
    "sidePanel",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_title": "Understand this YouTube video"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
